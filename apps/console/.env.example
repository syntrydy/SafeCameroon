VITE_API_BASE_URL=http://localhost:3000

# Must match apps/api's GOOGLE_OAUTH_CLIENT_ID (the id token this console
# obtains must have that same value as its `aud` claim). Not a secret --
# safe to ship in the built frontend bundle.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Per-deployment product name (multi-country support: one deployment per
# country). Optional -- defaults to "SafeCameroon" if unset.
VITE_BRAND_NAME=Sentinel

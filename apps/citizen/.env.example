# Copy this file to .env and fill in real values for local development.
# .env is gitignored. A real deployment sets this directly as an
# environment variable instead of using a .env file at all.

VITE_API_BASE_URL=http://localhost:3000

# Not a secret -- the public half of the API's VAPID keypair (VAPID_PRIVATE_KEY_BASE64
# in the api/worker's own .env.example), used to request a Web Push subscription.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Per-deployment product name (multi-country support: one deployment per
# country). Optional -- defaults to "SafeCameroon" if unset. A different
# country's deployment should also replace src/domain/knownTowns.ts.
VITE_BRAND_NAME=SafeCameroon

# Copy this file to .env and fill in real values for local development.
# .env is gitignored; never commit real secrets here. A real deployment sets
# these directly as environment variables instead of using a .env file at
# all (docs/DEPLOYMENT.md) -- dotenvy::dotenv() in both binaries' main()
# treats a missing .env as optional, not an error.

# Required by both apps/api and apps/worker.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safecameroon

# Required by apps/api only.
WEBHOOK_SHARED_SECRET=change-me-a-long-random-string
ATTACHMENT_STORAGE_SECRET=change-me-a-different-long-random-string
REVIEWER_SESSION_SECRET=change-me-yet-another-long-random-string

# Optional, apps/api only -- defaults to https://storage.sandbox.local.
# ATTACHMENT_STORAGE_BASE_URL=https://storage.example

# Optional, both apps -- defaults to "info".
# RUST_LOG=debug

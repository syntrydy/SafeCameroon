# Copy this file to .env and fill in real values for local development.
# .env is gitignored; never commit real secrets here. A real deployment sets
# these directly as environment variables instead of using a .env file at
# all (docs/DEPLOYMENT.md) -- dotenvy::dotenv() in both binaries' main()
# treats a missing .env as optional, not an error.

# Required by both apps/api and apps/worker.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safecameroon

# Required by apps/api only.
WEBHOOK_SHARED_SECRET=change-me-a-long-random-string
REVIEWER_SESSION_SECRET=change-me-yet-another-long-random-string

# Reviewers authenticate via Google sign-in, not a locally stored password
# (crates/application/src/google_identity.rs) -- this is the OAuth Client ID
# an id token's `aud` claim must match. Not a secret; safe to expose to the
# console frontend as well, since a client ID alone authorizes nothing.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Comma-separated allow-list of exact browser origins allowed to call the
# API (e.g. the console's deployed URL). Unset or empty allows none -- the
# API and console are always served from different origins, so a browser
# will silently block the console's requests until this is set.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Attachment storage, apps/api only. When all four R2_* vars below are set,
# apps/api uses real Cloudflare R2 (presigned PUT/GET URLs against R2's
# S3-compatible endpoint). Leave them unset to fall back to a mock/sandbox
# adapter for local dev -- in that mode ATTACHMENT_STORAGE_SECRET is
# required instead, and ATTACHMENT_STORAGE_BASE_URL is optional (defaults
# to https://storage.sandbox.local).
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET_NAME=safecameroon-attachments
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
ATTACHMENT_STORAGE_SECRET=change-me-a-different-long-random-string
# ATTACHMENT_STORAGE_BASE_URL=https://storage.example

# Required by apps/worker only: Web Push (VAPID) is the one real (non-mock)
# delivery channel, and the one a citizen can self-subscribe to
# (crates/infrastructure/src/channels/push.rs, docs/OPEN_QUESTIONS.md).
# Generate a keypair once:
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid_private.pem
#   openssl ec -in vapid_private.pem -pubout -outform DER | tail -c 65 | base64 | tr '/+' '_-' | tr -d '\n'
# VAPID_PRIVATE_KEY_BASE64 is `base64 -w0 vapid_private.pem` (the private key
# PEM itself, base64-encoded so its newlines never have to survive a shell/
# deployment-variable round trip verbatim). VAPID_SUBJECT is a contact URI
# the push service can reach you at if it needs to (a mailto: address or an
# https: URL), required by the VAPID spec.
VAPID_PRIVATE_KEY_BASE64=change-me-a-base64-encoded-ec-private-key-pem
VAPID_SUBJECT=mailto:you@example.com

# Optional, apps/api only: AI report extraction (docs/AI.md, CLAUDE.md "AI
# integration") -- an unverified reviewer-triggered suggestion, never
# applied to a report or case automatically. Leave unset to disable the
# feature entirely (extraction requests then fail with a clear error rather
# than the API refusing to boot) -- what data may go to an external AI
# provider is itself an open question (docs/OPEN_QUESTIONS.md), so this is
# opt-in per deployment. OPENROUTER_MODEL defaults to "openai/gpt-4o-mini".
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional, apps/worker only: Resend (https://resend.com) for the email
# channel. Leave both unset to keep using the mock/sandbox EmailChannel
# (stdout only) for local dev. RESEND_FROM_ADDRESS must be a sender Resend
# will actually let this API key send as -- either a verified domain's
# address for production ("SafeCameroon Alerts <alerts@yourdomain.org>"),
# or Resend's own "onboarding@resend.dev" for a quick local test (which
# Resend only allows sending to the account's own verified email address).
# RESEND_API_KEY=re_your-resend-api-key
# RESEND_FROM_ADDRESS=SafeCameroon Alerts <alerts@yourdomain.org>

# Optional, both apps -- defaults to "info".
# RUST_LOG=debug
